"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#9673A6;fontColor=#6B4A80;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="ses" target="users"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="after 3 failures" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#9673A6;fontColor=#6B4A80;" edge="1" parent="1" source="sqs" target="dlq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#9673A6;fontColor=#6B4A80;" edge="1" parent="1" source="eb" target="lam"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>