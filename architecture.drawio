<mxfile host="app.diagrams.net"><diagram name="SMS Architecture" id="sms"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Student Management System – Architecture (3-Tier + Event-Driven Notifications)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="L1" value="Users" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="620" height="100" as="geometry"/></mxCell><mxCell id="L2" value="Presentation Tier" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="620" height="100" as="geometry"/></mxCell><mxCell id="L3" value="Application Tier" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="620" height="230" as="geometry"/></mxCell><mxCell id="L4" value="Data Tier" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="1100" height="120" as="geometry"/></mxCell><mxCell id="L5" value="Monitoring" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1100" height="70" as="geometry"/></mxCell><mxCell id="L6" value="Asynchronous Notification Path (event-driven)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="460" height="470" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Students · Teachers · Admins&lt;/b&gt;&lt;br&gt;Web browser / mobile phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="80" width="360" height="60" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;Web Frontend (React SPA)&lt;/b&gt;&lt;br&gt;Static files on S3, served via CloudFront CDN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="200" width="360" height="60" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;API Gateway + Load Balancer&lt;/b&gt;&lt;br&gt;JWT auth check · routing · auto-scaling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="320" width="360" height="60" as="geometry"/></mxCell><mxCell id="be" value="&lt;b&gt;Backend API (stateless servers, auto-scaled)&lt;/b&gt;&lt;br&gt;Student · Course · Attendance · Results modules&lt;br&gt;Business rules &amp;amp; validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="420" width="360" height="90" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Redis Cache (ElastiCache)&lt;/b&gt;&lt;br&gt;Course lists, published results, sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="580" width="210" height="70" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;PostgreSQL (Amazon RDS)&lt;/b&gt;&lt;br&gt;Main records · Multi-AZ standby" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="410" y="580" width="220" height="70" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;S3 File Storage&lt;/b&gt;&lt;br&gt;Uploads &amp;amp; PDF transcripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="580" width="200" height="70" as="geometry"/></mxCell><mxCell id="ses" value="&lt;b&gt;Amazon SES / SNS&lt;/b&gt;&lt;br&gt;Delivers email &amp;amp; SMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="200" width="200" height="60" as="geometry"/></mxCell><mxCell id="lam" value="&lt;b&gt;AWS Lambda – Notifier&lt;/b&gt;&lt;br&gt;Builds &amp;amp; sends each message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="320" width="200" height="60" as="geometry"/></mxCell><mxCell id="eb" value="&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;Nightly attendance check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="910" y="320" width="190" height="60" as="geometry"/></mxCell><mxCell id="sqs" value="&lt;b&gt;Amazon SQS Queue&lt;/b&gt;&lt;br&gt;Buffers notification events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E9F7;strokeColor=#9673A6;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="435" width="200" height="60" as="geometry"/></mxCell><mxCell id="dlq" value="&lt;b&gt;Dead-Letter Queue&lt;/b&gt;&lt;br&gt;Failed messages kept for review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="910" y="435" width="190" height="60" as="geometry"/></mxCell><mxCell id="cw" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt; – logs, metrics and alarms for every component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="705" width="910" height="40" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;──── synchronous request (HTTPS / SQL)&lt;br&gt;&lt;font color='#9673A6'&gt;- - - -&lt;/font&gt; asynchronous event (SQS)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;strokeColor=#999999;fillColor=#FFFFFF;spacing=8;rounded=1;" vertex="1" parent="1"><mxGeometry x="910" y="80" width="200" height="70" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="users" target="fe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="REST API calls (JSON + JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="fe" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="routed request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="gw" target="be"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id=